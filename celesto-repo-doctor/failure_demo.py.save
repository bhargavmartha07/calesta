import uuid
from datetime import datetime, timezone
from pathlib import Path

REPORT_DIR = Path("reports")
LOG_DIR = Path("logs")
REPORT_DIR.mkdir(exist_ok=True)
LOG_DIR.mkdir(exist_ok=True)

run_id = f"failure-{uuid.uuid4().hex[:12]}"
events = []

def record(event, **details):
    entry = {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "run_id": run_id,
        "event": event,
        **details,
    }
    events.append(entry)
    print(json.dumps(entry))

# Steps 1–6 succeed.
for step in range(1, 7):
    record("step_completed", step=step)

# Deliberately simulate failure at step 7.
record(
    "step_failed",
    step=7,
    reason="Deliberate simulated failure",
    recovery_action="resume_from_step_8",
)

# Resume from step 8.
record("recovery_started", action="resume_from_step_8")

for step in range(8, 11):
    record("step_completed", step=step, recovered=True)

record(
    "workflow_completed",
    status="succeeded",
    failed_step=7,
    recovery_action="resume_from_step_8",
)

with (LOG_DIR / "failure_trace.jsonl").open("w", encoding="utf-8") as f:
    for event in events:
        f.write(json.dumps(event) + "\n")

policy = {
    "policy_name": "resume_after_simulated_step_failure",
    "failure_step": 7,
    "failure_type": "simulated",
    "recovery_action": "resume_from_step_8",
    "completed_steps_before_failure": [1, 2, 3, 4, 5, 6],
    "steps_after_recovery": [8, 9, 10],
    "final_status": "succeeded",
    "limitations": [
        "Controller-level simulation only.",
        "Real Celesto guest recovery has not been tested."
    ]
}

(REPORT_DIR / "failure_policy.json").write_text(
    json.dumps(policy, indent=2) + "\n",
    encoding="utf-8",
)

print("\nPASS: simulated step-7 failure and recovery trace recorded.")
